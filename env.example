# ============================================================================
#  kiwismir — environment variables template
#  Copy this file to ".env" and fill in the values:
#      cp env.example .env
#
#  ⚠️  NEVER commit .env to git — it contains your bot token!
#      The real .env is already in .gitignore.
# ============================================================================

# REQUIRED --------------------------------------------------------------------

# Telegram Bot API token from @BotFather (https://t.me/BotFather).
BOT_TOKEN=your_telegram_bot_token_here

# OPTIONAL (sensible defaults shown) ------------------------------------------

# Path or command name for the yt-dlp binary.
# In Docker this is just "yt-dlp" (installed via pip in the image).
# Locally on Windows point to the bundled exe: ./yt-dlp.exe
YTDLP_PATH=yt-dlp

# Path or command name for ffmpeg.
# In Docker: "ffmpeg". Locally on Windows: ./ffmpeg.exe
FFMPEG_PATH=ffmpeg

# Scratch directory for temporary downloads (cleaned after each upload).
DOWNLOAD_DIR=/tmp/kiwismir

# JSON file that persists per-user language preferences.
# In Docker this should be inside the /data volume.
DATA_FILE=/data/kiwismir_users.json

# Default language used before a user picks one.
# Supported: en, ru, it, fr, tr, de, kiwi
DEFAULT_LANG=en

# Maximum upload size in MB. Telegram Bot API caps bots at 50 MB.
MAX_FILE_SIZE_MB=50

# Per-download timeout in seconds.
DOWNLOAD_TIMEOUT_SEC=300

# Set to "true" for verbose telebot logging (development only).
DEBUG=false
