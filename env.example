# ============================================================================
#  kiwismir — environment variables template
#  Copy this file to ".env" and fill in the values:
#      cp env.example .env
#
#  ⚠️  NEVER commit .env to git — it contains your bot token!
#      The real .env is already in .gitignore.
# ============================================================================

# REQUIRED --------------------------------------------------------------------

# Telegram Bot API token from @BotFather (https://t.me/BotFather).
BOT_TOKEN=your_telegram_bot_token_here

# OPTIONAL (sensible defaults shown) ------------------------------------------

# Path or command name for the yt-dlp binary.
# In Docker this is just "yt-dlp" (installed via pip in the image).
# Locally on Windows point to the bundled exe: ./yt-dlp.exe
YTDLP_PATH=yt-dlp

# Path or command name for ffmpeg.
# In Docker: "ffmpeg". Locally on Windows: ./ffmpeg.exe
FFMPEG_PATH=ffmpeg

# Scratch directory for temporary downloads (cleaned after each upload).
DOWNLOAD_DIR=/tmp/kiwismir

# JSON file that persists per-user language preferences.
# In Docker this should be inside the /data volume.
DATA_FILE=/data/kiwismir_users.json

# Default language used before a user picks one.
# Supported: en, ru, it, fr, tr, de, kiwi
DEFAULT_LANG=en

# Maximum upload size in MB. Telegram Bot API caps bots at 50 MB.
MAX_FILE_SIZE_MB=50

# Per-download timeout in seconds.
DOWNLOAD_TIMEOUT_SEC=300

# Set to "true" for verbose telebot logging (development only).
DEBUG=false

# Optional: URL of a self-hosted Cobalt instance (e.g. https://cobalt.example.com).
# When set, YouTube downloads are routed through Cobalt instead of yt-dlp.
COBALT_API_URL=

# Set to "false" to disable the music features (/yt, /track, Spotify pastes).
MUSIC_DOWNLOAD_ENABLED=true

# yt-dlp binary used by the music service. Defaults to YTDLP_PATH when unset.
YTDLP_BIN=yt-dlp

# ffmpeg binary used by the music service. Defaults to FFMPEG_PATH when unset.
FFMPEG_BIN=ffmpeg

# Optional: path to a netscape-format cookies.txt passed to yt-dlp for
# Twitter/X links ONLY (unlocks age-restricted / sensitive tweets).
# Export it from a logged-in browser, e.g. with the "Get cookies.txt LOCALLY"
# browser extension. Leave empty to keep such tweets failing with a clear
# "login required" message.
COOKIES_FILE=

# Optional: Spotify Web API credentials — "full Spotify mode" (albums &
# playlists via the client-credentials flow). Create an app at
# https://developer.spotify.com/dashboard to get a pair.
# When unset, only single Spotify tracks work (resolved via public oEmbed).
# NEVER commit real values — these are placeholders.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
